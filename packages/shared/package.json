{
  "name": "@mini-vue/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/shared.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/shared.esm-bundler.js",
      "default": "./dist/shared.cjs"
    }
  },
  "main": "dist/shared.cjs",
  "module": "dist/shared.esm-bundler.js",
  "types": "dist/shared.d.ts",
  "sideEffects": false,
  "buildOptions": {
    "formats": [
      "esm-bundler",
      "cjs"
    ]
  }
}