{
  "name": "@mini-vue/vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/vue.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/vue.esm-bundler.js",
      "default": "./dist/vue.cjs"
    }
  },
  "dependencies": {
    "@mini-vue/runtime-dom": "workspace:*",
    "@mini-vue/runtime-core": "workspace:*",
    "@mini-vue/compiler-dom": "workspace:*",
    "@mini-vue/compiler-core": "workspace:*",
    "@mini-vue/shared": "workspace:*"
  },
  "main": "dist/vue.cjs",
  "module": "dist/vue.esm-bundler.js",
  "types": "dist/vue.d.ts",
  "sideEffects": false,
  "buildOptions": {
    "formats": [
      "esm-bundler",
      "cjs",
      "global"
    ],
    "name": "MiniVue"
  }
}