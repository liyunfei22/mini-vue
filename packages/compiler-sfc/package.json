{
  "name": "@mini-vue/compiler-sfc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/compiler-sfc.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/compiler-sfc.esm-bundler.js",
      "default": "./dist/compiler-sfc.cjs"
    }
  },
  "dependencies": {
    "@mini-vue/compiler-core": "workspace:*",
    "@mini-vue/compiler-dom": "workspace:*",
    "@mini-vue/shared": "workspace:*",
    "@babel/parser": "^7.25.0",
    "@babel/types": "^7.25.0",
    "magic-string": "^0.30.0"
  },
  "main": "dist/compiler-sfc.cjs",
  "module": "dist/compiler-sfc.esm-bundler.js",
  "types": "dist/compiler-sfc.d.ts",
  "sideEffects": false,
  "buildOptions": {
    "formats": [
      "esm-bundler",
      "cjs"
