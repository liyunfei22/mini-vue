{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": false,
    "paths": {
      "@mini-vue/shared": ["./packages/shared/src/index.ts"],
      "@mini-vue/reactivity": ["./packages/reactivity/src/index.ts"],
      "@mini-vue/runtime-core": ["./packages/runtime-core/src/index.ts"],
      "@mini-vue/runtime-dom": ["./packages/runtime-dom/src/index.ts"],
      "@mini-vue/compiler-core": ["./packages/compiler-core/src/index.ts"],
      "@mini-vue/compiler-dom": ["./packages/compiler-dom/src/index.ts"],
      "@mini-vue/vue": ["./packages/vue/src/index.ts"],
      "@mini-vue/vue-router": ["./packages/vue-router/src/index.ts"],
      "@mini-vue/pinia": ["./packages/pinia/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"]
}